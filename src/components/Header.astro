---
const currentPath = Astro.url.pathname;
const isEnglish = currentPath.startsWith('/en');
const navItems = [
  { href: '/', label: 'Anasayfa', icon: '🏠' },
  { href: '/dil', label: 'Diller', icon: '🌐' },
  { href: '/dil-trendleri', label: 'Dil Trendleri', icon: '📈' },
  { href: '/kategori', label: 'Kategoriler', icon: '🏷️' },
  { href: '/yukselen', label: 'Yükselen', icon: '🌟' },
  { href: '/ara', label: 'Ara', icon: '🔍' },
  { href: '/karsilastir', label: 'Karşılaştır', icon: '📊' },
  { href: '/arsiv', label: 'Arşiv', icon: '📁' },
  { href: '/blog', label: 'Blog', icon: '📝' },
  { href: '/haftalik', label: 'Haftalık', icon: '📅' },
  { href: '/hakkinda', label: 'Hakkında', icon: 'ℹ️' },
];
---
<header class="border-b border-[#30363d] bg-[#161b22] sticky top-0 z-50 backdrop-blur-sm bg-[#161b22]/95">
  <nav class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 group shrink-0">
      <span class="text-2xl">🔥</span>
      <div class="flex flex-col">
        <span class="text-base font-bold text-[#e6edf3] group-hover:text-[#58a6ff] transition-colors leading-tight">GitHub Trends</span>
        <span class="text-[10px] text-[#7d8590] leading-tight uppercase tracking-wider">Türkçe Analiz</span>
      </div>
    </a>

    <!-- Desktop nav -->
    <div class="hidden lg:flex items-center gap-1">
      {navItems.map(item => (
        <a
          href={item.href}
          class={`px-2 py-1.5 rounded-md text-xs transition-all whitespace-nowrap ${
            currentPath === item.href
              ? 'text-[#e6edf3] bg-[#30363d] font-medium'
              : 'text-[#7d8590] hover:text-[#e6edf3] hover:bg-[#21262d]'
          }`}
        >
          {item.label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-1 shrink-0">
      <!-- Language toggle -->
      <a
        href={isEnglish ? '/' : '/en'}
        class="text-[10px] px-2 py-1 rounded border border-[#30363d] text-[#7d8590] hover:text-[#e6edf3] hover:border-[#484f58] transition-colors font-semibold tracking-wide"
        title={isEnglish ? 'Türkçe' : 'English'}
      >
        {isEnglish ? 'TR' : 'EN'}
      </a>
      <button id="theme-toggle" onclick="toggleTheme()" class="text-sm px-2 py-1 rounded-md text-[#7d8590] hover:text-[#e6edf3] hover:bg-[#21262d] transition-all" title="Tema Değiştir">
        🌙
      </button>
      <!-- Mobile hamburger -->
      <button id="menu-toggle" class="lg:hidden text-[#7d8590] hover:text-[#e6edf3] p-1.5 rounded-md hover:bg-[#21262d] transition-all" aria-label="Menü">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-[#30363d] bg-[#161b22]">
    <div class="max-w-5xl mx-auto px-4 py-2 grid grid-cols-3 sm:grid-cols-4 gap-1">
      {navItems.map(item => (
        <a
          href={item.href}
          class={`px-3 py-2 rounded-md text-xs text-center transition-all ${
            currentPath === item.href
              ? 'text-[#e6edf3] bg-[#30363d] font-medium'
              : 'text-[#7d8590] hover:text-[#e6edf3] hover:bg-[#21262d]'
          }`}
        >
          <span class="block text-base mb-0.5">{item.icon}</span>
          {item.label}
        </a>
      ))}
    </div>
  </div>
</header>
<script is:inline>
  document.getElementById('menu-toggle')?.addEventListener('click', function() {
    const menu = document.getElementById('mobile-menu');
    menu.classList.toggle('hidden');
  });

  function toggleTheme() {
    const body = document.getElementById('app-body');
    const btn = document.getElementById('theme-toggle');
    if (body.classList.contains('light-theme')) {
      body.classList.remove('light-theme');
      localStorage.setItem('theme', 'dark');
      btn.textContent = '🌙';
    } else {
      body.classList.add('light-theme');
      localStorage.setItem('theme', 'light');
      btn.textContent = '☀️';
    }
  }
  (function() {
    const theme = localStorage.getItem('theme') || 'dark';
    const btn = document.getElementById('theme-toggle');
    if (btn) btn.textContent = theme === 'light' ? '☀️' : '🌙';
  })();
</script>
