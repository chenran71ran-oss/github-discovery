---
const { current = "daily" } = Astro.props;
const labels = {
  daily: "今日",
  weekly: "本周",
  monthly: "本月",
  rising: "Rising",
};
---

<nav class="periods" aria-label="榜单周期">
  {
    Object.entries(labels).map(([key, label]) => (
      <a href={"/?period=" + key} class:list={{ active: current === key }}>
        {label}
      </a>
    ))
  }
</nav>
