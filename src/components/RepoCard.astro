---
import type { ParsedRepo } from '../lib/db';

interface Props {
  repo: ParsedRepo;
}

const { repo } = Astro.props;
const summary = repo.parsedSummary;
const meta = repo.parsedMeta;

function timeAgo(dateStr: string): string {
  if (!dateStr) return '';
  const diff = Date.now() - new Date(dateStr).getTime();
  const hours = Math.floor(diff / 3600000);
  if (hours < 1) return 'az once';
  if (hours < 24) return `${hours} saat once`;
  const days = Math.floor(hours / 24);
  if (days < 30) return `${days} gun once`;
  const months = Math.floor(days / 30);
  return `${months} ay once`;
}

function repoAge(dateStr: string): string {
  if (!dateStr) return '';
  const diff = Date.now() - new Date(dateStr).getTime();
  const days = Math.floor(diff / 86400000);
  if (days < 30) return `${days} gunluk`;
  const months = Math.floor(days / 30);
  if (months < 12) return `${months} aylik`;
  const years = Math.floor(months / 12);
  return `${years} yillik`;
}

function formatNumber(n: number): string {
  if (n >= 10000) return `${(n / 1000).toFixed(0)}k`;
  if (n >= 1000) return `${(n / 1000).toFixed(1)}k`;
  return n.toString();
}

const langColors: Record<string, string> = {
  Python: '#3572A5',
  TypeScript: '#3178C6',
  JavaScript: '#F7DF1E',
  Rust: '#DEA584',
  Go: '#00ADD8',
  Java: '#B07219',
  'C++': '#F34B7D',
  C: '#555555',
  Swift: '#F05138',
  Kotlin: '#A97BFF',
  Ruby: '#CC342D',
  PHP: '#4F5D95',
  Zig: '#F7A41D',
  Shell: '#89E051',
  Dart: '#00B4AB',
  HTML: '#E34C26',
  CSS: '#563D7C',
};

const langColor = langColors[repo.language] ?? '#7d8590';

const periodStyles: Record<string, { bg: string; text: string; label: string }> = {
  daily: { bg: 'bg-green-500/10', text: 'text-green-400', label: 'Günlük' },
  weekly: { bg: 'bg-blue-500/10', text: 'text-blue-400', label: 'Haftalık' },
  monthly: { bg: 'bg-purple-500/10', text: 'text-purple-400', label: 'Aylık' },
};

const ps = periodStyles[repo.period] ?? periodStyles.daily;
---
<article class="group border border-[#30363d] rounded-xl bg-[#161b22] overflow-hidden hover:border-[#484f58] transition-all hover:shadow-lg hover:shadow-black/20">
  <!-- Top color bar -->
  <div class="h-0.5" style={`background: ${langColor}`} />

  <div class="p-5">
    <!-- Header row -->
    <div class="flex items-start justify-between gap-3 mb-3">
      <div class="flex items-center gap-2 flex-wrap min-w-0">
        <span class="shrink-0 text-[#7d8590] text-xs font-mono bg-[#0d1117] px-2 py-0.5 rounded-md border border-[#30363d]">#{repo.rank}</span>
        <a href={`/repo/${repo.owner}/${repo.name}`} class="text-[#58a6ff] text-base font-semibold hover:underline truncate">
          <span class="text-[#7d8590] font-normal">{repo.owner}/</span>{repo.name}
        </a>
      </div>
      <span class={`shrink-0 text-[10px] font-semibold px-2 py-1 rounded-md uppercase tracking-wide ${ps.bg} ${ps.text}`}>
        {ps.label}
      </span>
    </div>

    <!-- Stats bar -->
    <div class="flex items-center gap-3 text-xs text-[#7d8590] mb-3 flex-wrap">
      {repo.language && (
        <span class="flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full inline-block" style={`background: ${langColor}`} />
          {repo.language}
        </span>
      )}
      <span class="flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 16 16"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/></svg>
        {formatNumber(repo.stars)}
      </span>
      <span class="flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 16 16"><path d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z"/></svg>
        {formatNumber(repo.forks)}
      </span>
      {repo.period_stars > 0 && (
        <span class="flex items-center gap-1 text-[#f0883e] font-semibold">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 16 16"><path d="M7.998 14.5c2.832 0 5-1.98 5-4.5 0-1.463-.68-2.19-1.879-3.383l-.036-.037C9.865 5.344 8.747 4.108 8.247 2.32l-.165-.538-.312.39C6.73 3.474 5.165 5.31 5.03 7.637 4.361 7.225 3.89 6.497 3.756 5.667l-.095-.532-.34.464a5.25 5.25 0 0 0-.117.174c-.65 1.02-.997 2.168-.997 3.227 0 2.52 2.168 4.5 5 4.5Z"/></svg>
          +{formatNumber(repo.period_stars)}
        </span>
      )}
    </div>

    <!-- Meta info bar -->
    {meta && (
      <div class="flex items-center gap-3 text-[10px] text-[#484f58] mb-3 flex-wrap">
        {meta.license && meta.license !== 'NOASSERTION' && (
          <span class="flex items-center gap-1 bg-[#0d1117] px-2 py-0.5 rounded border border-[#21262d]">
            📄 {meta.license}
          </span>
        )}
        {meta.openIssues > 0 && (
          <span class="flex items-center gap-1">
            🔓 {formatNumber(meta.openIssues)} açık issue
          </span>
        )}
        {meta.lastPush && (
          <span class="flex items-center gap-1">
            🕐 Son commit: {timeAgo(meta.lastPush)}
          </span>
        )}
        {meta.createdAt && (
          <span class="flex items-center gap-1">
            📅 {repoAge(meta.createdAt)} proje
          </span>
        )}
        {meta.watchers > 0 && (
          <span class="flex items-center gap-1">
            👁 {formatNumber(meta.watchers)} izleyici
          </span>
        )}
      </div>
    )}

    <!-- Topics -->
    {meta?.topics && meta.topics.length > 0 && (
      <div class="flex flex-wrap gap-1 mb-3">
        {meta.topics.map(t => (
          <span class="text-[10px] bg-[#121d2f] text-[#58a6ff] px-2 py-0.5 rounded-full border border-[#1f3d5f]">{t}</span>
        ))}
      </div>
    )}

    <!-- English description -->
    {repo.description && (
      <p class="text-[#8b949e] text-sm border-l-2 border-[#30363d] pl-3 mb-4 leading-relaxed">
        {repo.description}
      </p>
    )}

    <!-- AI Summary -->
    {summary && (
      <div class="bg-[#0d1117] rounded-lg p-4 mb-4 border border-[#21262d]">
        <div class="flex items-center gap-1.5 mb-2">
          <span class="text-xs font-semibold text-[#7d8590] uppercase tracking-wide">🤖 Türkçe AI Analizi</span>
        </div>
        <p class="text-[#e6edf3] text-sm leading-relaxed mb-3">{summary.summary}</p>
        <p class="text-[#a5d6ff] text-xs mb-3">
          🎯 <strong>Hedef Kitle:</strong> {summary.targetAudience}
        </p>
        {summary.highlights.length > 0 && (
          <div class="flex flex-wrap gap-1.5">
            {summary.highlights.map(h => (
              <span class="text-xs bg-[#21262d] text-[#c9d1d9] px-2 py-1 rounded-md border border-[#30363d]">
                {h}
              </span>
            ))}
          </div>
        )}
        {summary.usageExample && (
          <div class="mt-3 bg-[#122117] rounded-lg p-3 border border-[#1f3a1f]">
            <div class="flex items-center gap-1.5 mb-1.5">
              <span class="text-[10px] font-semibold text-[#3fb950] uppercase tracking-wide">💡 Kullanım Örneği</span>
            </div>
            <p class="text-xs text-[#c9d1d9] leading-relaxed">{summary.usageExample}</p>
          </div>
        )}
      </div>
    )}

    <!-- Actions -->
    <div class="flex items-center justify-between">
      <a href={`/repo/${repo.owner}/${repo.name}`} class="text-xs font-medium text-[#58a6ff] hover:text-[#79c0ff] transition-colors">
        Detaylı İncele →
      </a>
      <a href={repo.url} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 text-xs text-[#7d8590] hover:text-[#e6edf3] transition-colors">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 16 16"><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/></svg>
        GitHub
      </a>
    </div>
  </div>
</article>
