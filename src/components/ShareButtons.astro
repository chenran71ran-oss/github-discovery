---
interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
---
<div class="flex items-center gap-2 mt-4">
  <span class="text-xs text-[#7d8590]">Paylaş:</span>
  <a href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-xs bg-[#21262d] text-[#7d8590] px-3 py-1.5 rounded-md border border-[#30363d] hover:border-[#484f58] hover:text-[#e6edf3] transition-colors">
    𝕏 Twitter
  </a>
  <a href={`https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-xs bg-[#21262d] text-[#7d8590] px-3 py-1.5 rounded-md border border-[#30363d] hover:border-[#484f58] hover:text-[#e6edf3] transition-colors">
    ✈️ Telegram
  </a>
  <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-xs bg-[#21262d] text-[#7d8590] px-3 py-1.5 rounded-md border border-[#30363d] hover:border-[#484f58] hover:text-[#e6edf3] transition-colors">
    💼 LinkedIn
  </a>
  <button onclick="navigator.clipboard.writeText(window.location.href).then(()=>this.textContent='✓ Kopyalandı')" class="flex items-center gap-1 text-xs bg-[#21262d] text-[#7d8590] px-3 py-1.5 rounded-md border border-[#30363d] hover:border-[#484f58] hover:text-[#e6edf3] transition-colors cursor-pointer">
    📋 Kopyala
  </button>
</div>
