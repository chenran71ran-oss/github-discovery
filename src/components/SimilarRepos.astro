---
import type { ParsedRepo } from '../lib/db';

interface Props {
  repos: ParsedRepo[];
}

const { repos } = Astro.props;

function formatNumber(n: number): string {
  if (n >= 1000) return `${(n / 1000).toFixed(1)}k`;
  return n.toString();
}

function truncate(str: string, max: number): string {
  if (!str) return '';
  return str.length > max ? str.slice(0, max) + '…' : str;
}

const langColors: Record<string, string> = {
  Python: '#3572A5',
  TypeScript: '#3178C6',
  JavaScript: '#F7DF1E',
  Rust: '#DEA584',
  Go: '#00ADD8',
  Java: '#B07219',
  'C++': '#F34B7D',
  C: '#555555',
  Swift: '#F05138',
  Kotlin: '#A97BFF',
  Ruby: '#CC342D',
  PHP: '#4F5D95',
  Zig: '#F7A41D',
  Shell: '#89E051',
  Dart: '#00B4AB',
  HTML: '#E34C26',
  CSS: '#563D7C',
};
---

{repos.length > 0 && (
  <div class="border border-[#30363d] rounded-lg bg-[#161b22] p-5 mb-6">
    <h2 class="text-sm font-semibold text-[#7d8590] mb-3">🔗 Benzer Projeler</h2>
    <div class="space-y-3">
      {repos.map(repo => {
        const langColor = langColors[repo.language] ?? '#7d8590';
        return (
          <div class="flex items-start gap-3 py-2 border-b border-[#21262d] last:border-0">
            <div class="flex-1 min-w-0">
              <a
                href={`/repo/${repo.owner}/${repo.name}`}
                class="text-[#58a6ff] text-sm font-medium hover:underline block truncate"
              >
                <span class="text-[#7d8590] font-normal">{repo.owner}/</span>{repo.name}
              </a>
              {repo.description && (
                <p class="text-xs text-[#8b949e] mt-0.5 leading-snug">
                  {truncate(repo.description, 80)}
                </p>
              )}
            </div>
            <div class="flex items-center gap-2 shrink-0 text-xs text-[#7d8590]">
              {repo.language && (
                <span class="flex items-center gap-1">
                  <span class="w-2 h-2 rounded-full inline-block" style={`background: ${langColor}`} />
                  {repo.language}
                </span>
              )}
              <span class="flex items-center gap-0.5">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 16 16">
                  <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/>
                </svg>
                {formatNumber(repo.stars)}
              </span>
            </div>
          </div>
        );
      })}
    </div>
  </div>
)}
