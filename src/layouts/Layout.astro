---
import "../styles/global.css";
interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "发现值得尝试的开源项目：GitHub 热榜、中文解读、历史与 Rising 增长排行。",
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><meta name="description" content={description} /><meta
      name="color-scheme"
      content="light dark"
    /><meta name="theme-color" content="#2860dc" /><link
      rel="icon"
      href="/favicon.svg"
      type="image/svg+xml"
    /><link rel="manifest" href="/manifest.json" /><title>{title}</title><script
      is:inline
    >
      try {
        const t = localStorage.getItem("discovery-theme") || "system";
        document.documentElement.dataset.theme =
          t === "system"
            ? matchMedia("(prefers-color-scheme:dark)").matches
              ? "dark"
              : "light"
            : t;
      } catch {}
    </script></head
  ><body
    ><a class="skip-link" href="#repo-grid">跳转到项目列表</a><slot /></body>
</html>
