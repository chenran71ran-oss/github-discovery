---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  jsonLd?: Record<string, unknown>;
  ogType?: string;
  ogImage?: string;
}

const {
  title,
  description = "GitHub'da trend olan acik kaynak projelerin Turkce AI analizleri. Gunluk, haftalik ve aylik trending repolar.",
  canonicalPath,
  jsonLd,
  ogType = 'website',
  ogImage,
} = Astro.props;

const siteUrl = 'https://trends.softween.com';
const canonical = canonicalPath ? `${siteUrl}${canonicalPath}` : Astro.url.href;
---
<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="GitHub Trends TR" href="/rss.xml" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="GitHub Trends TR" />
  <meta property="og:locale" content="tr_TR" />

  {ogImage && <meta property="og:image" content={ogImage} />}
  {ogImage && <meta name="twitter:image" content={ogImage} />}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <!-- SEO -->
  <meta name="robots" content="index, follow" />
  <meta name="language" content="Turkish" />
  <meta name="author" content="Softween" />
  <meta name="theme-color" content="#0d1117" />

  <!-- JSON-LD -->
  {jsonLd && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  )}
</head>
<body class="min-h-screen flex flex-col" id="app-body">
  <Header />
  <main class="flex-1 max-w-5xl mx-auto w-full px-4 sm:px-6 py-8">
    <slot />
  </main>
  <Footer />
  <script is:inline>
    (function() {
      const theme = localStorage.getItem('theme') || 'dark';
      const body = document.getElementById('app-body');
      if (theme === 'light') {
        body.classList.add('light-theme');
      }
    })();
  </script>
</body>
</html>
