---
import Layout from '../layouts/Layout.astro';

const pageTitle = 'API Docs — GitHub Trends TR Public API';
const pageDesc = 'GitHub Trends TR public REST API documentation. Query trending repos by period and language. Free, no auth required.';

const baseUrl = 'https://trends.softween.com';
---
<Layout title={pageTitle} description={pageDesc} canonicalPath="/api-docs">
  <div class="max-w-3xl mx-auto">
    <h1 class="text-3xl font-bold mb-2 text-[#e6edf3]">📡 Public API</h1>
    <p class="text-[#7d8590] text-sm mb-8">
      Free access to GitHub trending data. No authentication required.
    </p>

    <!-- Base URL -->
    <section class="bg-[#161b22] border border-[#30363d] rounded-xl p-6 mb-6">
      <h2 class="text-base font-semibold text-[#e6edf3] mb-3">Base URL</h2>
      <code class="block bg-[#0d1117] border border-[#30363d] rounded-lg px-4 py-3 text-[#58a6ff] text-sm font-mono">
        {baseUrl}
      </code>
    </section>

    <!-- Endpoints -->
    <section class="bg-[#161b22] border border-[#30363d] rounded-xl p-6 mb-6">
      <h2 class="text-base font-semibold text-[#e6edf3] mb-4">Endpoints</h2>

      <!-- GET /api/trending -->
      <div class="mb-6">
        <div class="flex items-center gap-2 mb-3">
          <span class="text-xs font-bold bg-[#238636]/20 text-[#3fb950] border border-[#238636]/40 px-2 py-0.5 rounded">GET</span>
          <code class="text-[#e6edf3] text-sm font-mono">/api/trending</code>
        </div>
        <p class="text-[#7d8590] text-sm mb-4">Returns the latest snapshot of trending GitHub repositories with AI-powered Turkish analysis.</p>

        <!-- Query Parameters -->
        <h3 class="text-sm font-semibold text-[#c9d1d9] mb-2">Query Parameters</h3>
        <div class="overflow-x-auto mb-4">
          <table class="w-full text-sm border-collapse">
            <thead>
              <tr class="border-b border-[#30363d]">
                <th class="text-left py-2 px-3 text-[#7d8590] font-medium text-xs uppercase tracking-wide">Param</th>
                <th class="text-left py-2 px-3 text-[#7d8590] font-medium text-xs uppercase tracking-wide">Type</th>
                <th class="text-left py-2 px-3 text-[#7d8590] font-medium text-xs uppercase tracking-wide">Default</th>
                <th class="text-left py-2 px-3 text-[#7d8590] font-medium text-xs uppercase tracking-wide">Description</th>
              </tr>
            </thead>
            <tbody class="text-[#c9d1d9]">
              <tr class="border-b border-[#21262d]">
                <td class="py-2 px-3 font-mono text-[#58a6ff] text-xs">period</td>
                <td class="py-2 px-3 text-xs">string</td>
                <td class="py-2 px-3 text-xs font-mono text-[#7d8590]">daily</td>
                <td class="py-2 px-3 text-xs">One of: <code class="text-[#58a6ff]">daily</code>, <code class="text-[#58a6ff]">weekly</code>, <code class="text-[#58a6ff]">monthly</code></td>
              </tr>
              <tr class="border-b border-[#21262d]">
                <td class="py-2 px-3 font-mono text-[#58a6ff] text-xs">language</td>
                <td class="py-2 px-3 text-xs">string</td>
                <td class="py-2 px-3 text-xs font-mono text-[#7d8590]">—</td>
                <td class="py-2 px-3 text-xs">Filter by programming language, e.g. <code class="text-[#58a6ff]">Python</code></td>
              </tr>
              <tr>
                <td class="py-2 px-3 font-mono text-[#58a6ff] text-xs">limit</td>
                <td class="py-2 px-3 text-xs">integer</td>
                <td class="py-2 px-3 text-xs font-mono text-[#7d8590]">25</td>
                <td class="py-2 px-3 text-xs">Max results to return (1–100)</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Example requests -->
        <h3 class="text-sm font-semibold text-[#c9d1d9] mb-2">Example Requests</h3>
        <div class="space-y-3">
          <div>
            <p class="text-xs text-[#484f58] mb-1">Daily trending (default):</p>
            <pre class="bg-[#0d1117] border border-[#30363d] rounded-lg px-4 py-3 text-xs font-mono text-[#c9d1d9] overflow-x-auto"><code>curl "{baseUrl}/api/trending"</code></pre>
          </div>
          <div>
            <p class="text-xs text-[#484f58] mb-1">Weekly trending Python repos:</p>
            <pre class="bg-[#0d1117] border border-[#30363d] rounded-lg px-4 py-3 text-xs font-mono text-[#c9d1d9] overflow-x-auto"><code>curl "{baseUrl}/api/trending?period=weekly&language=Python"</code></pre>
          </div>
          <div>
            <p class="text-xs text-[#484f58] mb-1">Monthly top 10:</p>
            <pre class="bg-[#0d1117] border border-[#30363d] rounded-lg px-4 py-3 text-xs font-mono text-[#c9d1d9] overflow-x-auto"><code>curl "{baseUrl}/api/trending?period=monthly&limit=10"</code></pre>
          </div>
        </div>
      </div>

      <!-- GET /api/snapshot -->
      <div class="border-t border-[#30363d] pt-6">
        <div class="flex items-center gap-2 mb-3">
          <span class="text-xs font-bold bg-[#238636]/20 text-[#3fb950] border border-[#238636]/40 px-2 py-0.5 rounded">GET</span>
          <code class="text-[#e6edf3] text-sm font-mono">/api/snapshot</code>
        </div>
        <p class="text-[#7d8590] text-sm mb-3">Returns metadata about the latest data snapshot (date, total repo count).</p>
        <pre class="bg-[#0d1117] border border-[#30363d] rounded-lg px-4 py-3 text-xs font-mono text-[#c9d1d9] overflow-x-auto"><code>curl "{baseUrl}/api/snapshot"</code></pre>
      </div>
    </section>

    <!-- Response format -->
    <section class="bg-[#161b22] border border-[#30363d] rounded-xl p-6 mb-6">
      <h2 class="text-base font-semibold text-[#e6edf3] mb-4">Response Format</h2>
      <p class="text-[#7d8590] text-sm mb-3">All responses are JSON. Successful responses follow this shape:</p>
      <pre class="bg-[#0d1117] border border-[#30363d] rounded-lg px-4 py-4 text-xs font-mono text-[#c9d1d9] overflow-x-auto"><code>{`{
  "success": true,
  "date": "2024-01-15",
  "period": "daily",
  "total": 25,
  "repos": [
    {
      "owner": "vercel",
      "name": "next.js",
      "full_name": "vercel/next.js",
      "description": "The React Framework for the Web",
      "language": "TypeScript",
      "stars": 120000,
      "period_stars": 342,
      "forks": 26000,
      "url": "https://github.com/vercel/next.js",
      "ai_summary": "...",       // Turkish AI summary
      "ai_features": [...],      // Turkish feature list
      "ai_target_audience": "...", // Turkish
      "ai_usage_example": "..."  // Turkish
    }
  ]
}`}</code></pre>

      <h3 class="text-sm font-semibold text-[#c9d1d9] mt-5 mb-2">Error Response</h3>
      <pre class="bg-[#0d1117] border border-[#30363d] rounded-lg px-4 py-3 text-xs font-mono text-[#c9d1d9] overflow-x-auto"><code>{`{
  "success": false,
  "error": "Invalid period. Use: daily, weekly, monthly"
}`}</code></pre>
    </section>

    <!-- Rate limits -->
    <section class="bg-[#161b22] border border-[#30363d] rounded-xl p-6 mb-6">
      <h2 class="text-base font-semibold text-[#e6edf3] mb-3">Rate Limits</h2>
      <div class="space-y-2 text-sm text-[#c9d1d9]">
        <div class="flex items-start gap-2">
          <span class="text-[#f0883e] mt-0.5">⚠</span>
          <p>Please limit requests to <strong class="text-[#e6edf3]">1 request per second</strong> as a courtesy. There is no hard rate limit currently, but abusive usage may result in IP blocking.</p>
        </div>
        <div class="flex items-start gap-2">
          <span class="text-[#3fb950] mt-0.5">✓</span>
          <p>Data is updated once per day (07:00 AM Turkey time). Caching responses for 1 hour is recommended.</p>
        </div>
        <div class="flex items-start gap-2">
          <span class="text-[#58a6ff] mt-0.5">ℹ</span>
          <p>No API key required. The API is provided free of charge for personal and open source use.</p>
        </div>
      </div>
    </section>

    <!-- Notes -->
    <section class="bg-[#161b22] border border-[#30363d] rounded-xl p-6 mb-6">
      <h2 class="text-base font-semibold text-[#e6edf3] mb-3">Notes</h2>
      <ul class="space-y-2 text-sm text-[#7d8590]">
        <li class="flex items-start gap-2">
          <span class="mt-0.5">•</span>
          <span>AI analysis fields (<code class="text-[#58a6ff]">ai_*</code>) are in <strong class="text-[#c9d1d9]">Turkish</strong> — that's the core value proposition of this service.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="mt-0.5">•</span>
          <span>Repos without AI analysis will have <code class="text-[#58a6ff]">null</code> in those fields.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="mt-0.5">•</span>
          <span>Data source: GitHub Trending page, processed by Cloudflare Workers AI.</span>
        </li>
      </ul>
    </section>

    <!-- Attribution -->
    <div class="text-center text-xs text-[#484f58] pb-4">
      Built with ❤️ by <a href="https://softween.com" class="text-[#58a6ff] hover:underline">Softween</a>.
      If you use this API in a project, a mention would be appreciated.
    </div>
  </div>
</Layout>
