---
import Layout from '../layouts/Layout.astro';
import RepoCard from '../components/RepoCard.astro';
import { searchRepos } from '../lib/db';
import type { ParsedRepo } from '../lib/db';

const db = Astro.locals.runtime.env.DB as D1Database;
const q = Astro.url.searchParams.get('q')?.trim() ?? '';

let results: ParsedRepo[] = [];
let searched = false;

if (q.length >= 2) {
  results = await searchRepos(db, q, 30);
  searched = true;
}

const pageTitle = q
  ? `"${q}" için ${results.length} sonuç — GitHub Trends TR`
  : 'Proje Ara — GitHub Trends TR';
const pageDesc = 'GitHub trending projelerinde arama yap. Repo adı, açıklama veya Türkçe AI analizine göre filtrele.';
---
<Layout title={pageTitle} description={pageDesc} canonicalPath="/ara">
  <div class="mb-6">
    <nav class="text-xs text-[#7d8590] mb-4 flex items-center gap-2">
      <a href="/" class="hover:text-[#58a6ff] transition-colors">Anasayfa</a>
      <span>/</span>
      <span class="text-[#e6edf3]">Ara</span>
    </nav>
    <h1 class="text-2xl sm:text-3xl font-bold text-[#e6edf3] mb-2">
      🔍 Proje Ara
    </h1>
    <p class="text-[#7d8590] text-sm">
      Repo adı, açıklama veya Türkçe AI analizine göre arama yap.
    </p>
  </div>

  <!-- Search form -->
  <form method="get" action="/ara" class="mb-8">
    <div class="flex gap-2">
      <input
        type="text"
        name="q"
        value={q}
        placeholder="Örnek: yapay zeka, python, web scraper..."
        autofocus
        class="flex-1 bg-[#0d1117] border border-[#30363d] rounded-xl px-4 py-3 text-[#e6edf3] placeholder-[#484f58] text-sm focus:outline-none focus:border-[#58a6ff] focus:ring-1 focus:ring-[#58a6ff]/30 transition-all"
      />
      <button
        type="submit"
        class="px-5 py-3 bg-[#238636] hover:bg-[#2ea043] text-white text-sm font-medium rounded-xl transition-colors flex items-center gap-2"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        Ara
      </button>
    </div>
    {q.length === 1 && (
      <p class="text-[#f0883e] text-xs mt-2">En az 2 karakter girin.</p>
    )}
  </form>

  <!-- Results -->
  {searched && (
    <div class="mb-6">
      {results.length > 0 ? (
        <div class="flex items-center gap-2 mb-4">
          <span class="text-sm text-[#7d8590]">
            <span class="font-semibold text-[#e6edf3]">{results.length}</span> sonuç bulundu
          </span>
          <span class="text-[#7d8590] text-xs">— "<span class="text-[#58a6ff]">{q}</span>"</span>
        </div>
      ) : (
        <div class="text-center py-16 text-[#7d8590]">
          <span class="text-4xl block mb-4">😕</span>
          <p class="text-lg font-medium mb-2">Sonuç bulunamadı</p>
          <p class="text-sm mb-1">"<span class="text-[#58a6ff]">{q}</span>" için eşleşen proje yok.</p>
          <p class="text-sm text-[#484f58]">Farklı anahtar kelimeler deneyin.</p>
        </div>
      )}

      {results.length > 0 && (
        <div class="space-y-4">
          {results.map(repo => <RepoCard repo={repo} />)}
        </div>
      )}
    </div>
  )}

  {!searched && (
    <div class="text-center py-12 text-[#7d8590]">
      <span class="text-5xl block mb-4">🔎</span>
      <p class="text-base font-medium mb-1">Ne arıyorsun?</p>
      <p class="text-sm text-[#484f58]">Yukarıdaki alana yazmaya başla.</p>
    </div>
  )}
</Layout>
