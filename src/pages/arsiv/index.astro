---
import Layout from '../../layouts/Layout.astro';
import { getAvailableDates } from '../../lib/db';

const db = Astro.locals.runtime.env.DB as D1Database;
const dates = await getAvailableDates(db);
---
<Layout title="GitHub Trending Arşivi — Geçmiş Günlerin Trend Projeleri | GitHub Trends TR" description="GitHub'da geçmiş günlerde trend olan projelerin arşivi. Her günün trending repolarını Türkçe AI analizleriyle inceleyin." canonicalPath="/arsiv">
  <h1 class="text-3xl font-bold mb-2">📁 Arşiv</h1>
  <p class="text-[#7d8590] mb-6">Geçmiş günlerin trending projelerini inceleyin.</p>

  {dates.length > 0 ? (
    <div class="space-y-2">
      {dates.map((d, i) => (
        <a href={`/arsiv/${d.date}`} class="group flex items-center justify-between border border-[#30363d] rounded-xl bg-[#161b22] p-4 hover:border-[#484f58] hover:bg-[#1c2128] transition-all">
          <div class="flex items-center gap-3">
            <span class="text-[#484f58] text-xs font-mono w-6 text-right">{i + 1}</span>
            <span class="text-[#e6edf3] font-medium group-hover:text-[#58a6ff] transition-colors">{d.date}</span>
            {i === 0 && <span class="text-[10px] bg-green-500/15 text-green-400 px-2 py-0.5 rounded-full font-semibold">Bugün</span>}
          </div>
          <span class="text-[#7d8590] text-sm">{d.repo_count} proje →</span>
        </a>
      ))}
    </div>
  ) : (
    <div class="text-center py-16 text-[#7d8590]">
      <span class="text-4xl block mb-4">📭</span>
      <p class="text-lg font-medium mb-2">Henüz arşiv verisi yok</p>
      <p class="text-sm">Veriler her gün 07:00 TR saatinde güncellenir.</p>
    </div>
  )}
</Layout>
