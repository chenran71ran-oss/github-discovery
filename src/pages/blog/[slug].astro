---
import Layout from '../../layouts/Layout.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import Comments from '../../components/Comments.astro';
import { getBlogPostBySlug } from '../../lib/db';
import type { BlogPostRow } from '../../lib/db';

const { slug } = Astro.params;
const db = Astro.locals.runtime.env.DB as D1Database;
const post: BlogPostRow | null = await getBlogPostBySlug(db, slug as string);

if (!post) {
  return Astro.redirect('/blog');
}

const pageTitle = `${post.title} | GitHub Trends TR`;
const pageDesc = post.excerpt;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  datePublished: post.date,
  dateModified: post.created_at,
  inLanguage: 'tr',
  author: {
    '@type': 'Organization',
    name: 'Softween',
    url: 'https://softween.com',
  },
  publisher: {
    '@type': 'Organization',
    name: 'GitHub Trends TR',
    url: 'https://trends.softween.com',
  },
};

function formatDate(dateStr: string): string {
  const [year, month, day] = dateStr.split('-');
  const months = ['Ocak','Şubat','Mart','Nisan','Mayıs','Haziran','Temmuz','Ağustos','Eylül','Ekim','Kasım','Aralık'];
  return `${parseInt(day)} ${months[parseInt(month) - 1]} ${year}`;
}
---
<Layout title={pageTitle} description={pageDesc} canonicalPath={`/blog/${post.slug}`} jsonLd={jsonLd} ogType="article">
  <div class="mb-6">
    <a href="/blog" class="text-sm text-[#7d8590] hover:text-[#58a6ff] transition-colors inline-flex items-center gap-1">
      ← Tüm Yazılar
    </a>
  </div>

  <article class="bg-[#161b22] border border-[#30363d] rounded-xl p-6 sm:p-8">
    <header class="mb-6 pb-6 border-b border-[#30363d]">
      <h1 class="text-2xl sm:text-3xl font-bold text-[#e6edf3] leading-snug mb-3">
        {post.title}
      </h1>
      <div class="flex items-center gap-3 flex-wrap">
        <span class="text-sm text-[#7d8590]">{formatDate(post.date)}</span>
        <span class="text-xs bg-[#21262d] text-[#58a6ff] px-2 py-0.5 rounded-full border border-[#30363d]">
          {post.type === 'daily' ? 'Günlük' : post.type === 'weekly' ? 'Haftalık' : post.type}
        </span>
        <span class="text-xs text-[#484f58]">GitHub Trends TR</span>
      </div>
    </header>

    <div
      class="prose prose-invert prose-sm sm:prose-base max-w-none
             prose-headings:text-[#e6edf3] prose-headings:font-semibold
             prose-h2:text-xl prose-h2:mt-6 prose-h2:mb-3
             prose-h3:text-base prose-h3:mt-4 prose-h3:mb-2
             prose-p:text-[#c9d1d9] prose-p:leading-relaxed prose-p:mb-4
             prose-ul:text-[#c9d1d9] prose-li:mb-1
             prose-strong:text-[#e6edf3]
             prose-a:text-[#58a6ff] prose-a:no-underline hover:prose-a:underline"
      set:html={post.content}
    />
  </article>

  <ShareButtons url={`https://trends.softween.com/blog/${post.slug}`} title={`${post.title} — GitHub Trends TR`} />

  <div class="mt-6 text-center">
    <a href="/blog" class="inline-flex items-center gap-2 bg-[#21262d] border border-[#30363d] text-[#c9d1d9] hover:text-[#e6edf3] hover:border-[#58a6ff] px-4 py-2 rounded-lg text-sm transition-all">
      ← Diğer Yazılar
    </a>
  </div>

  <Comments term={post.slug} />
</Layout>
