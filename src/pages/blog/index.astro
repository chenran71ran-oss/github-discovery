---
import Layout from '../../layouts/Layout.astro';
import { getBlogPosts } from '../../lib/db';
import type { BlogPostRow } from '../../lib/db';

const db = Astro.locals.runtime.env.DB as D1Database;
const posts: BlogPostRow[] = await getBlogPosts(db, 30);

const pageTitle = 'Blog — GitHub Trending Türkçe Analizleri | GitHub Trends TR';
const pageDesc = "GitHub'da trend olan projelerin günlük Türkçe blog özetleri. Yapay zeka destekli analizlerle öne çıkan açık kaynak projeleri keşfet.";

function formatDate(dateStr: string): string {
  const [year, month, day] = dateStr.split('-');
  const months = ['Ocak','Şubat','Mart','Nisan','Mayıs','Haziran','Temmuz','Ağustos','Eylül','Ekim','Kasım','Aralık'];
  return `${parseInt(day)} ${months[parseInt(month) - 1]} ${year}`;
}
---
<Layout title={pageTitle} description={pageDesc} canonicalPath="/blog">
  <div class="mb-8">
    <h1 class="text-3xl sm:text-4xl font-bold mb-3 bg-gradient-to-r from-[#e6edf3] to-[#7d8590] bg-clip-text text-transparent">
      📝 Blog
    </h1>
    <p class="text-[#7d8590] text-sm">GitHub Trending'in günlük Türkçe AI analizleri</p>
  </div>

  {posts.length > 0 ? (
    <div class="space-y-4">
      {posts.map(post => (
        <a href={`/blog/${post.slug}`} class="block bg-[#161b22] border border-[#30363d] rounded-lg p-5 hover:border-[#58a6ff] transition-all group">
          <div class="flex items-start justify-between gap-3">
            <div class="flex-1 min-w-0">
              <h2 class="text-base font-semibold text-[#e6edf3] group-hover:text-[#58a6ff] transition-colors leading-snug mb-2">
                {post.title}
              </h2>
              <p class="text-sm text-[#7d8590] line-clamp-2 leading-relaxed">
                {post.excerpt}
              </p>
            </div>
          </div>
          <div class="flex items-center gap-3 mt-3">
            <span class="text-xs text-[#484f58]">{formatDate(post.date)}</span>
            <span class="text-xs bg-[#21262d] text-[#58a6ff] px-2 py-0.5 rounded-full border border-[#30363d]">
              {post.type === 'daily' ? 'Günlük' : post.type === 'weekly' ? 'Haftalık' : post.type}
            </span>
          </div>
        </a>
      ))}
    </div>
  ) : (
    <div class="text-center py-16 text-[#7d8590]">
      <span class="text-4xl block mb-4">📝</span>
      <p class="text-lg font-medium mb-2">Henüz blog yazısı yok</p>
      <p class="text-sm">Blog yazıları her gün 07:00 TR saatinde otomatik oluşturulur.</p>
    </div>
  )}
</Layout>
