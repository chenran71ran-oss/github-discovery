---
import Layout from '../layouts/Layout.astro';
import { getLanguageTrends } from '../lib/db';

const db = Astro.locals.runtime.env.DB as D1Database;
const rows = await getLanguageTrends(db);

// Build sorted list of unique dates and languages
const dateSet = new Set<string>();
const langSet = new Set<string>();

for (const r of rows) {
  dateSet.add(r.date);
  langSet.add(r.language);
}

const dates = [...dateSet].sort();
const recentDates = dates.slice(-7);

// Build a lookup: { date -> { language -> count } }
type DayMap = Record<string, number>;
const dataMap: Record<string, DayMap> = {};
for (const r of rows) {
  if (!dataMap[r.date]) dataMap[r.date] = {};
  dataMap[r.date][r.language] = r.count;
}

// Determine #1 language per day
const dayLeaders: Record<string, string> = {};
for (const date of recentDates) {
  const day = dataMap[date] ?? {};
  let topLang = '';
  let topCount = 0;
  for (const [lang, count] of Object.entries(day)) {
    if (count > topCount) { topCount = count; topLang = lang; }
  }
  dayLeaders[date] = topLang;
}

// Aggregate total count per language across the period
const langTotals: Record<string, number> = {};
for (const r of rows) {
  if (!recentDates.includes(r.date)) continue;
  langTotals[r.language] = (langTotals[r.language] ?? 0) + r.count;
}

// Sort languages by total descending, keep top 15
const sortedLangs = Object.entries(langTotals)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 15)
  .map(([lang]) => lang);

const weeklyTopLang = sortedLangs[0] ?? '';

// Max count across all cells for bar scaling
const maxCount = Math.max(...rows.map(r => r.count), 1);

const langColors: Record<string, string> = {
  Python: '#3572A5',
  TypeScript: '#3178C6',
  JavaScript: '#F7DF1E',
  Rust: '#DEA584',
  Go: '#00ADD8',
  Java: '#B07219',
  'C++': '#F34B7D',
  C: '#555555',
  Swift: '#F05138',
  Kotlin: '#A97BFF',
  Ruby: '#CC342D',
  PHP: '#4F5D95',
  Zig: '#F7A41D',
  Shell: '#89E051',
  Dart: '#00B4AB',
  HTML: '#E34C26',
  CSS: '#563D7C',
};

function shortDate(d: string): string {
  // "2025-03-28" -> "28 Mar"
  const [, m, day] = d.split('-');
  const months = ['', 'Oca', 'Şub', 'Mar', 'Nis', 'May', 'Haz', 'Tem', 'Ağu', 'Eyl', 'Eki', 'Kas', 'Ara'];
  return `${parseInt(day)} ${months[parseInt(m)] ?? m}`;
}

const pageTitle = 'Dil Trendleri — Son 7 Gün | GitHub Trends TR';
const pageDesc = 'Son 7 günde GitHub trending listesindeki programlama dillerinin günlük popülerlik değişimi.';
---

<Layout title={pageTitle} description={pageDesc} canonicalPath="/dil-trendleri">
  <div class="mb-6">
    <a href="/" class="text-[#58a6ff] text-sm hover:underline mb-4 inline-block">← Ana Sayfa</a>
    <h1 class="text-2xl font-bold mb-2">📈 Dil Trendleri — Son 7 Gün</h1>
    <p class="text-[#7d8590] text-sm">{pageDesc}</p>
  </div>

  {weeklyTopLang && (
    <div class="border border-[#238636] rounded-lg bg-[#122117] p-4 mb-6 flex items-center gap-3">
      <span class="text-2xl">🏆</span>
      <div>
        <div class="text-sm text-[#3fb950] font-semibold">Bu hafta en çok trend olan dil</div>
        <div class="text-lg font-bold text-[#e6edf3]" style={`color: ${langColors[weeklyTopLang] ?? '#e6edf3'}`}>
          {weeklyTopLang}
        </div>
      </div>
    </div>
  )}

  {recentDates.length === 0 ? (
    <div class="border border-[#30363d] rounded-lg bg-[#161b22] p-8 text-center text-[#7d8590]">
      Henüz yeterli veri bulunmuyor.
    </div>
  ) : (
    <div class="border border-[#30363d] rounded-lg bg-[#161b22] overflow-x-auto mb-6">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="border-b border-[#30363d]">
            <th class="text-left px-4 py-3 text-[#7d8590] font-medium w-32 sticky left-0 bg-[#161b22]">Dil</th>
            {recentDates.map(date => (
              <th class={`px-3 py-3 text-center font-medium min-w-[80px] ${dayLeaders[date] ? '' : ''}`}>
                <div class="text-[#e6edf3]">{shortDate(date)}</div>
                {dayLeaders[date] && (
                  <div class="text-[10px] text-[#f0883e] font-normal mt-0.5">🥇 {dayLeaders[date]}</div>
                )}
              </th>
            ))}
            <th class="px-3 py-3 text-center font-medium text-[#7d8590] min-w-[80px]">Toplam</th>
          </tr>
        </thead>
        <tbody>
          {sortedLangs.map((lang, idx) => {
            const color = langColors[lang] ?? '#7d8590';
            const total = langTotals[lang] ?? 0;
            return (
              <tr class={`border-b border-[#21262d] last:border-0 ${idx % 2 === 0 ? '' : 'bg-[#0d1117]/30'}`}>
                <td class="px-4 py-2.5 sticky left-0 bg-inherit">
                  <a href={`/dil/${encodeURIComponent(lang.toLowerCase())}`} class="flex items-center gap-2 hover:underline">
                    <span class="w-2.5 h-2.5 rounded-full shrink-0" style={`background: ${color}`} />
                    <span class="text-[#e6edf3] font-medium">{lang}</span>
                  </a>
                </td>
                {recentDates.map(date => {
                  const count = dataMap[date]?.[lang] ?? 0;
                  const isLeader = dayLeaders[date] === lang;
                  const barPct = Math.round((count / maxCount) * 100);
                  return (
                    <td class={`px-3 py-2.5 text-center align-middle ${isLeader ? 'bg-[#1f3d1f]/60' : ''}`}>
                      {count > 0 ? (
                        <div class="flex flex-col items-center gap-1">
                          <span class={`text-xs font-semibold ${isLeader ? 'text-[#3fb950]' : 'text-[#c9d1d9]'}`}>
                            {count}
                            {isLeader && <span class="ml-0.5">🥇</span>}
                          </span>
                          <div class="w-full bg-[#21262d] rounded-full h-1.5 max-w-[60px]">
                            <div
                              class="h-1.5 rounded-full"
                              style={`width: ${barPct}%; background: ${color}`}
                            />
                          </div>
                        </div>
                      ) : (
                        <span class="text-[#484f58]">—</span>
                      )}
                    </td>
                  );
                })}
                <td class="px-3 py-2.5 text-center">
                  <span class="text-xs font-bold text-[#f0883e]">{total}</span>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  )}

  <div class="border border-[#30363d] rounded-lg bg-[#161b22] p-5">
    <h2 class="text-sm font-semibold text-[#7d8590] mb-4">Dil Popülerliği (Görsel)</h2>
    <div class="space-y-3">
      {sortedLangs.map(lang => {
        const color = langColors[lang] ?? '#7d8590';
        const total = langTotals[lang] ?? 0;
        const maxTotal = langTotals[sortedLangs[0]] ?? 1;
        const pct = Math.round((total / maxTotal) * 100);
        return (
          <div class="flex items-center gap-3">
            <a href={`/dil/${encodeURIComponent(lang.toLowerCase())}`} class="w-24 text-xs text-[#c9d1d9] hover:underline truncate text-right shrink-0">
              {lang}
            </a>
            <div class="flex-1 bg-[#21262d] rounded-full h-3 overflow-hidden">
              <div
                class="h-3 rounded-full transition-all"
                style={`width: ${pct}%; background: ${color}`}
              />
            </div>
            <span class="w-8 text-xs text-[#7d8590] text-right">{total}</span>
          </div>
        );
      })}
    </div>
  </div>
</Layout>
