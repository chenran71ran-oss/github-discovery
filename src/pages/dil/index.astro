---
import Layout from '../../layouts/Layout.astro';
import { getLatestSnapshot, getLanguageStats } from '../../lib/db';

const db = Astro.locals.runtime.env.DB as D1Database;

const snapshot = await getLatestSnapshot(db);
let languages: Array<{ language: string; count: number }> = [];
let snapshotDate = '';

if (snapshot) {
  languages = await getLanguageStats(db, snapshot.id);
  snapshotDate = snapshot.date;
}

const langColors: Record<string, string> = {
  Python: '#3572A5',
  TypeScript: '#3178C6',
  JavaScript: '#F7DF1E',
  Rust: '#DEA584',
  Go: '#00ADD8',
  Java: '#B07219',
  'C++': '#F34B7D',
  C: '#555555',
  Swift: '#F05138',
  Kotlin: '#A97BFF',
  Ruby: '#CC342D',
  PHP: '#4F5D95',
  Zig: '#F7A41D',
  Shell: '#89E051',
  Dart: '#00B4AB',
  HTML: '#E34C26',
  CSS: '#563D7C',
};

const pageTitle = 'Dillere Göre Trending Projeler — GitHub Trends TR';
const pageDesc = "Programlama diline göre filtrelenmiş GitHub trending projelerini keşfet. Python, TypeScript, Rust, Go ve daha fazlası.";
---
<Layout title={pageTitle} description={pageDesc} canonicalPath="/dil">
  <div class="mb-6">
    <nav class="text-xs text-[#7d8590] mb-4 flex items-center gap-2">
      <a href="/" class="hover:text-[#58a6ff] transition-colors">Anasayfa</a>
      <span>/</span>
      <span class="text-[#e6edf3]">Diller</span>
    </nav>
    <h1 class="text-2xl sm:text-3xl font-bold text-[#e6edf3] mb-2">
      🌐 Programlama Dillerine Göre
    </h1>
    <p class="text-[#7d8590] text-sm">
      Dile göre filtrele ve istediğin teknoloji alanındaki trend projeleri keşfet.
    </p>
    {snapshotDate && (
      <p class="text-[#484f58] text-xs mt-2">Son güncelleme: {snapshotDate}</p>
    )}
  </div>

  {languages.length > 0 ? (
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
      {languages.map(({ language, count }) => {
        const color = langColors[language] ?? '#7d8590';
        const slug = language.toLowerCase().replace(/[^a-z0-9+#]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
        return (
          <a
            href={`/dil/${encodeURIComponent(slug)}`}
            class="group border border-[#30363d] rounded-xl bg-[#161b22] p-4 hover:border-[#484f58] transition-all hover:shadow-lg hover:shadow-black/20 flex flex-col gap-2"
          >
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full shrink-0" style={`background: ${color}`} />
              <span class="text-sm font-semibold text-[#e6edf3] group-hover:text-[#58a6ff] transition-colors truncate">{language}</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-xs text-[#7d8590]">{count} proje</span>
              <span class="text-xs text-[#484f58] group-hover:text-[#58a6ff] transition-colors">→</span>
            </div>
          </a>
        );
      })}
    </div>
  ) : (
    <div class="text-center py-16 text-[#7d8590]">
      <span class="text-4xl block mb-4">🌐</span>
      <p class="text-lg font-medium mb-2">Henüz veri yok</p>
      <p class="text-sm">Veriler her gün 07:00 TR saatinde güncellenir.</p>
    </div>
  )}
</Layout>
