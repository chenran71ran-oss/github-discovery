---
import Layout from '../../layouts/Layout.astro';
import RepoCard from '../../components/RepoCard.astro';
import PeriodTabs from '../../components/PeriodTabs.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { getLatestSnapshot, getReposBySnapshot } from '../../lib/db';
import type { ParsedRepo } from '../../lib/db';

const db = Astro.locals.runtime.env.DB as D1Database;
const period = (Astro.url.searchParams.get('period') ?? 'daily') as 'daily' | 'weekly' | 'monthly';

const snapshot = await getLatestSnapshot(db);
let allRepos: ParsedRepo[] = [];
let repos: ParsedRepo[] = [];
let snapshotDate = '';

if (snapshot) {
  allRepos = await getReposBySnapshot(db, snapshot.id);
  repos = allRepos.filter(r => r.period === period);
  snapshotDate = snapshot.date;
}

const dailyCount = allRepos.filter(r => r.period === 'daily').length;
const weeklyCount = allRepos.filter(r => r.period === 'weekly').length;
const monthlyCount = allRepos.filter(r => r.period === 'monthly').length;

// Top languages
const langCounts = allRepos.reduce((acc, r) => {
  if (r.language) acc[r.language] = (acc[r.language] || 0) + 1;
  return acc;
}, {} as Record<string, number>);
const topLangs = Object.entries(langCounts).sort((a, b) => b[1] - a[1]).slice(0, 5);

// Total stars
const totalStars = allRepos.reduce((sum, r) => sum + (r.period_stars || 0), 0);

const periodTitles: Record<string, string> = {
  daily: 'Daily',
  weekly: 'Weekly',
  monthly: 'Monthly',
};

const pageTitle = `${periodTitles[period]} GitHub Trending — Turkish AI Analysis | GitHub Trends TR`;
const pageDesc = `Discover ${repos.length} trending GitHub repositories with AI-powered Turkish analysis. ${periodTitles[period]} trending repos explained — what they do and how to use them.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'GitHub Trends TR',
  url: 'https://trends.softween.com/en',
  description: pageDesc,
  inLanguage: 'en',
  publisher: {
    '@type': 'Organization',
    name: 'Softween',
    url: 'https://softween.com',
  },
};

function formatK(n: number): string {
  if (n >= 1000) return `${(n / 1000).toFixed(0)}k`;
  return n.toString();
}
---
<Layout title={pageTitle} description={pageDesc} canonicalPath={period === 'daily' ? '/en' : `/en?period=${period}`} jsonLd={jsonLd}>
  <!-- Hero -->
  <div class="text-center mb-8">
    <h1 class="text-3xl sm:text-4xl font-bold mb-3 bg-gradient-to-r from-[#e6edf3] to-[#7d8590] bg-clip-text text-transparent">
      What's Trending on GitHub Today?
    </h1>
    <p class="text-[#7d8590] text-sm">Discover trending open source projects with AI-powered Turkish analysis</p>
    {snapshotDate && (
      <p class="text-[#484f58] text-xs mt-2">Last updated: {snapshotDate}</p>
    )}
    <p class="text-xs mt-2">
      <a href="/" class="text-[#58a6ff] hover:underline">🇹🇷 Türkçe sürüm</a>
    </p>
  </div>

  <!-- Stats bar -->
  {allRepos.length > 0 && (
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8">
      <div class="bg-[#161b22] border border-[#30363d] rounded-lg p-3 text-center">
        <div class="text-xl font-bold text-[#e6edf3]">{allRepos.length}</div>
        <div class="text-[10px] text-[#7d8590] uppercase tracking-wide">Total Projects</div>
      </div>
      <div class="bg-[#161b22] border border-[#30363d] rounded-lg p-3 text-center">
        <div class="text-xl font-bold text-[#f0883e]">+{formatK(totalStars)}</div>
        <div class="text-[10px] text-[#7d8590] uppercase tracking-wide">New Stars</div>
      </div>
      <div class="bg-[#161b22] border border-[#30363d] rounded-lg p-3 text-center">
        <div class="text-xl font-bold text-[#58a6ff]">{Object.keys(langCounts).length}</div>
        <div class="text-[10px] text-[#7d8590] uppercase tracking-wide">Languages</div>
      </div>
      <div class="bg-[#161b22] border border-[#30363d] rounded-lg p-3 text-center">
        <div class="text-xl font-bold text-green-400">{topLangs[0]?.[0] ?? '-'}</div>
        <div class="text-[10px] text-[#7d8590] uppercase tracking-wide">Top Language</div>
      </div>
    </div>
  )}

  <PeriodTabs current={period} baseUrl="/en" counts={{ daily: dailyCount, weekly: weeklyCount, monthly: monthlyCount }} />

  {repos.length > 0 ? (
    <div class="space-y-4">
      {repos.map(repo => <RepoCard repo={repo} />)}
    </div>
  ) : (
    <div class="text-center py-16 text-[#7d8590]">
      <span class="text-4xl block mb-4">🔍</span>
      <p class="text-lg font-medium mb-2">No data yet</p>
      <p class="text-sm">Data is updated daily at 07:00 AM (Turkey time).</p>
    </div>
  )}

  <NewsletterForm />
</Layout>
