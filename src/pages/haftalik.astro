---
import Layout from '../layouts/Layout.astro';
import { getWeeklyReport } from '../lib/db';

const db = Astro.locals.runtime.env.DB as D1Database;
const { snapshots, topRepos } = await getWeeklyReport(db);

const pageTitle = 'Haftalık Rapor — GitHub Trending Son 7 Gün | GitHub Trends TR';
const pageDesc = "GitHub Trending'in son 7 günlük özeti. Haftanın en çok görünen projeleri, dil istatistikleri ve trend analizi.";

// Language stats across the week
const langCounts: Record<string, number> = {};
for (const repo of topRepos) {
  if (repo.language) {
    langCounts[repo.language] = (langCounts[repo.language] || 0) + repo.appearances;
  }
}
const topLangs = Object.entries(langCounts).sort((a, b) => b[1] - a[1]).slice(0, 8);

// Unique repos across the week (based on full_name)
const uniqueRepoNames = new Set(topRepos.map(r => r.full_name));

// Total appearances
const totalAppearances = topRepos.reduce((sum, r) => sum + r.appearances, 0);

function formatDate(dateStr: string): string {
  const [year, month, day] = dateStr.split('-');
  const months = ['Ocak','Şubat','Mart','Nisan','Mayıs','Haziran','Temmuz','Ağustos','Eylül','Ekim','Kasım','Aralık'];
  return `${parseInt(day)} ${months[parseInt(month) - 1]} ${year}`;
}

function formatK(n: number): string {
  if (n >= 1000) return `${(n / 1000).toFixed(1)}k`;
  return n.toString();
}

const langColors: Record<string, string> = {
  Python: '#3572A5',
  TypeScript: '#3178c6',
  JavaScript: '#f1e05a',
  Go: '#00ADD8',
  Rust: '#dea584',
  Java: '#b07219',
  'C++': '#f34b7d',
  C: '#555555',
  'C#': '#178600',
  Ruby: '#701516',
  Swift: '#F05138',
  Kotlin: '#A97BFF',
  PHP: '#4F5D95',
  Shell: '#89e051',
};
---
<Layout title={pageTitle} description={pageDesc} canonicalPath="/haftalik">
  <div class="mb-8">
    <h1 class="text-3xl sm:text-4xl font-bold mb-3 bg-gradient-to-r from-[#e6edf3] to-[#7d8590] bg-clip-text text-transparent">
      📅 Haftalık Rapor
    </h1>
    <p class="text-[#7d8590] text-sm">Son 7 günün GitHub Trending özeti</p>
    {snapshots.length > 0 && (
      <p class="text-[#484f58] text-xs mt-2">
        {formatDate(snapshots[snapshots.length - 1]?.date ?? '')} – {formatDate(snapshots[0]?.date ?? '')}
      </p>
    )}
  </div>

  {snapshots.length === 0 ? (
    <div class="text-center py-16 text-[#7d8590]">
      <span class="text-4xl block mb-4">📅</span>
      <p class="text-lg font-medium mb-2">Henüz yeterli veri yok</p>
      <p class="text-sm">Veriler her gün 07:00 TR saatinde güncellenir.</p>
    </div>
  ) : (
    <div class="space-y-8">

      {/* Summary stats */}
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="bg-[#161b22] border border-[#30363d] rounded-lg p-4 text-center">
          <div class="text-2xl font-bold text-[#e6edf3]">{snapshots.length}</div>
          <div class="text-[10px] text-[#7d8590] uppercase tracking-wide mt-1">Gün</div>
        </div>
        <div class="bg-[#161b22] border border-[#30363d] rounded-lg p-4 text-center">
          <div class="text-2xl font-bold text-[#58a6ff]">{uniqueRepoNames.size}</div>
          <div class="text-[10px] text-[#7d8590] uppercase tracking-wide mt-1">Benzersiz Proje</div>
        </div>
        <div class="bg-[#161b22] border border-[#30363d] rounded-lg p-4 text-center">
          <div class="text-2xl font-bold text-[#f0883e]">{topLangs.length}</div>
          <div class="text-[10px] text-[#7d8590] uppercase tracking-wide mt-1">Aktif Dil</div>
        </div>
        <div class="bg-[#161b22] border border-[#30363d] rounded-lg p-4 text-center">
          <div class="text-2xl font-bold text-green-400">{topLangs[0]?.[0] ?? '-'}</div>
          <div class="text-[10px] text-[#7d8590] uppercase tracking-wide mt-1">Lider Dil</div>
        </div>
      </div>

      {/* Daily snapshots timeline */}
      <div class="bg-[#161b22] border border-[#30363d] rounded-xl p-5">
        <h2 class="text-base font-semibold text-[#e6edf3] mb-4">Günlük Özet</h2>
        <div class="space-y-2">
          {snapshots.map(snap => (
            <div class="flex items-center justify-between py-2 border-b border-[#21262d] last:border-0">
              <span class="text-sm text-[#c9d1d9]">{formatDate(snap.date)}</span>
              <div class="flex items-center gap-3">
                <span class="text-xs text-[#7d8590]">{snap.repo_count} proje</span>
                <a href={`/?date=${snap.date}`} class="text-xs text-[#58a6ff] hover:underline">Görüntüle →</a>
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* Top repos of the week */}
      {topRepos.length > 0 && (
        <div class="bg-[#161b22] border border-[#30363d] rounded-xl p-5">
          <h2 class="text-base font-semibold text-[#e6edf3] mb-4">Haftanın En Çok Görünen Projeleri</h2>
          <div class="space-y-3">
            {topRepos.map((repo, index) => (
              <div class="flex items-start gap-3 py-3 border-b border-[#21262d] last:border-0">
                <span class="text-sm font-bold text-[#484f58] w-6 shrink-0 pt-0.5">#{index + 1}</span>
                <div class="flex-1 min-w-0">
                  <a
                    href={`/repo/${repo.owner}/${repo.name}`}
                    class="text-sm font-medium text-[#58a6ff] hover:underline block truncate"
                  >
                    {repo.full_name}
                  </a>
                  {repo.description && (
                    <p class="text-xs text-[#7d8590] mt-0.5 line-clamp-1">{repo.description}</p>
                  )}
                  <div class="flex items-center gap-3 mt-1.5 flex-wrap">
                    {repo.language && (
                      <span class="text-xs text-[#7d8590] flex items-center gap-1">
                        <span
                          class="inline-block w-2.5 h-2.5 rounded-full"
                          style={`background-color: ${langColors[repo.language] ?? '#8b949e'}`}
                        />
                        {repo.language}
                      </span>
                    )}
                    <span class="text-xs text-[#7d8590]">⭐ {formatK(repo.stars)}</span>
                    <span class="text-xs bg-[#21262d] text-[#3fb950] px-2 py-0.5 rounded-full border border-[#30363d]">
                      {repo.appearances} gün trend
                    </span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* Top languages */}
      {topLangs.length > 0 && (
        <div class="bg-[#161b22] border border-[#30363d] rounded-xl p-5">
          <h2 class="text-base font-semibold text-[#e6edf3] mb-4">Haftanın Dil İstatistikleri</h2>
          <div class="space-y-3">
            {topLangs.map(([lang, count]) => {
              const maxCount = topLangs[0]?.[1] ?? 1;
              const pct = Math.round((count / maxCount) * 100);
              return (
                <div class="flex items-center gap-3">
                  <div class="flex items-center gap-2 w-28 shrink-0">
                    <span
                      class="inline-block w-2.5 h-2.5 rounded-full shrink-0"
                      style={`background-color: ${langColors[lang] ?? '#8b949e'}`}
                    />
                    <span class="text-sm text-[#c9d1d9] truncate">{lang}</span>
                  </div>
                  <div class="flex-1 bg-[#21262d] rounded-full h-2 overflow-hidden">
                    <div
                      class="h-full rounded-full bg-[#58a6ff] transition-all"
                      style={`width: ${pct}%`}
                    />
                  </div>
                  <span class="text-xs text-[#7d8590] w-8 text-right shrink-0">{count}</span>
                </div>
              );
            })}
          </div>
        </div>
      )}

    </div>
  )}
</Layout>
