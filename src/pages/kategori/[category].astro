---
import Layout from '../../layouts/Layout.astro';
import RepoCard from '../../components/RepoCard.astro';
import { getLatestSnapshot, getReposByCategory } from '../../lib/db';
import type { ParsedRepo } from '../../lib/db';

const db = Astro.locals.runtime.env.DB as D1Database;
const { category } = Astro.params;

const snapshot = await getLatestSnapshot(db);
let repos: ParsedRepo[] = [];
let snapshotDate = '';

if (snapshot && category) {
  repos = await getReposByCategory(db, snapshot.id, decodeURIComponent(category));
  snapshotDate = snapshot.date;
}

const displayCategory = category ? decodeURIComponent(category) : 'Bilinmiyor';

const categoryEmojis: Record<string, string> = {
  'AI/ML': '🤖',
  'Web Dev': '🌐',
  'DevOps': '⚙️',
  'Mobile': '📱',
  'Data': '📊',
  'Security': '🔒',
  'CLI Tool': '💻',
  'Finance': '💰',
  'Game': '🎮',
  'Education': '📚',
  'Other': '📦',
};

const emoji = categoryEmojis[displayCategory] ?? '📦';

const periodGroups: Record<string, ParsedRepo[]> = {
  daily: repos.filter(r => r.period === 'daily'),
  weekly: repos.filter(r => r.period === 'weekly'),
  monthly: repos.filter(r => r.period === 'monthly'),
};

const pageTitle = `${displayCategory} Trending Projeleri — GitHub Trends TR`;
const pageDesc = `GitHub'da trend olan ${displayCategory} projeleri. Türkçe AI analizleriyle günlük, haftalık ve aylık ${displayCategory} repoları.`;
---
<Layout title={pageTitle} description={pageDesc} canonicalPath={`/kategori/${category}`}>
  <div class="mb-6">
    <nav class="text-xs text-[#7d8590] mb-4 flex items-center gap-2">
      <a href="/" class="hover:text-[#58a6ff] transition-colors">Anasayfa</a>
      <span>/</span>
      <a href="/kategori" class="hover:text-[#58a6ff] transition-colors">Kategoriler</a>
      <span>/</span>
      <span class="text-[#e6edf3]">{displayCategory}</span>
    </nav>
    <h1 class="text-2xl sm:text-3xl font-bold text-[#e6edf3] mb-2">
      {emoji} {displayCategory} Projeleri
    </h1>
    <p class="text-[#7d8590] text-sm">
      GitHub'da trend olan tüm {displayCategory} açık kaynak projeleri.
    </p>
    {snapshotDate && (
      <p class="text-[#484f58] text-xs mt-2">Son güncelleme: {snapshotDate}</p>
    )}
  </div>

  {repos.length > 0 ? (
    <div class="space-y-8">
      {periodGroups.daily.length > 0 && (
        <section>
          <h2 class="text-base font-semibold mb-4 flex items-center gap-2 text-green-400">
            <span>📅</span>
            <span>Günlük Trending</span>
            <span class="text-xs font-normal bg-[#30363d] text-[#7d8590] px-2 py-0.5 rounded-full">{periodGroups.daily.length}</span>
          </h2>
          <div class="space-y-4">
            {periodGroups.daily.map(repo => <RepoCard repo={repo} />)}
          </div>
        </section>
      )}
      {periodGroups.weekly.length > 0 && (
        <section>
          <h2 class="text-base font-semibold mb-4 flex items-center gap-2 text-blue-400">
            <span>📊</span>
            <span>Haftalık Trending</span>
            <span class="text-xs font-normal bg-[#30363d] text-[#7d8590] px-2 py-0.5 rounded-full">{periodGroups.weekly.length}</span>
          </h2>
          <div class="space-y-4">
            {periodGroups.weekly.map(repo => <RepoCard repo={repo} />)}
          </div>
        </section>
      )}
      {periodGroups.monthly.length > 0 && (
        <section>
          <h2 class="text-base font-semibold mb-4 flex items-center gap-2 text-purple-400">
            <span>📈</span>
            <span>Aylık Trending</span>
            <span class="text-xs font-normal bg-[#30363d] text-[#7d8590] px-2 py-0.5 rounded-full">{periodGroups.monthly.length}</span>
          </h2>
          <div class="space-y-4">
            {periodGroups.monthly.map(repo => <RepoCard repo={repo} />)}
          </div>
        </section>
      )}
    </div>
  ) : (
    <div class="text-center py-16 text-[#7d8590]">
      <span class="text-4xl block mb-4">{emoji}</span>
      <p class="text-lg font-medium mb-2">Bu kategori için şu an proje bulunamadı</p>
      <p class="text-sm mb-6">Başka bir kategori denemek ister misin?</p>
      <a href="/kategori" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-[#21262d] border border-[#30363d] text-sm text-[#58a6ff] hover:border-[#484f58] transition-all">
        ← Tüm Kategorilere Dön
      </a>
    </div>
  )}
</Layout>
