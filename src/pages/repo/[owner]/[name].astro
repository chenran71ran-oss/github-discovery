---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { getRepoDetail } from "../../../lib/db";
import { number } from "../../../lib/card";
const { owner, name } = Astro.params;
let detail = null;
try {
  detail = await getRepoDetail(Astro.locals.runtime.env.DB, owner + "/" + name);
} catch {
  Astro.response.status = 503;
}
if (!detail && Astro.response.status !== 503) Astro.response.status = 404;
---

<Layout
  title={detail
    ? detail.repo.fullName + " · GitHub Discovery"
    : "项目暂不可用 · GitHub Discovery"}
  ><Header /><main class="shell">
    {
      detail ? (
        <article class="detail-page">
          <div class="detail-stats">
            <>
              <span>☆ {number(detail.repo.stars)} Stars</span>
              <span>⑂ {number(detail.repo.forks)} Forks</span>
              <span>{detail.repo.language}</span>
              <span>{detail.repo.license || "许可待确认"}</span>
            </>
          </div>
          {detail.repo.summary ? (
            <>
              <h2>适用场景</h2>
              <p>{detail.repo.summary.useCase}</p>
              <h2>技术栈</h2>
              <div class="tags">
                {detail.repo.summary.techStack.map((s) => (
                  <span class="tag">{s}</span>
                ))}
              </div>
              <h2>值得关注</h2>
              <ul>
                {detail.repo.summary.highlights.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </>
          ) : (
            <p class="detail-muted">中文摘要待更新，目前展示原始仓库描述。</p>
          )}
          <h2>最近榜单记录</h2>
          <>
            <table>
              <>
                <thead>
                  <tr>
                    <>
                      <th>采集时间（北京时间）</th>
                      <th>榜单</th>
                      <th>名次</th>
                      <th>Star</th>
                    </>
                  </tr>
                </thead>
                <tbody>
                  {detail.history.slice(0, 12).map((r) => (
                    <tr>
                      <td>
                        {new Date(r.capturedAt).toLocaleString("zh-CN", {
                          timeZone: "Asia/Shanghai",
                          month: "2-digit",
                          day: "2-digit",
                          hour: "2-digit",
                          minute: "2-digit",
                        })}
                      </td>
                      <td>
                        {r.period === "daily"
                          ? "今日"
                          : r.period === "weekly"
                            ? "本周"
                            : "本月"}
                      </td>
                      <td>#{r.rank}</td>
                      <td>{number(r.stars)}</td>
                    </tr>
                  ))}
                </tbody>
              </>
            </table>
            <details class="readme-panel">
              <>
                <summary>README 原文</summary>
                <pre>
                  {detail.repo.readme ?? "原文尚未缓存，可前往 GitHub 阅读。"}
                </pre>
              </>
            </details>
            <div class="detail-bottom">
              <a
                class="button primary"
                href={detail.repo.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                在 GitHub 打开 ↗
              </a>
            </div>
          </>
        </article>
      ) : (
        <section class="error-page">
          <>
            <h1>项目暂不可用</h1>
            <p>可能尚未采集该项目，或数据库暂时不可用。</p>
            <a class="button secondary" href="/">
              返回首页
            </a>
          </>
        </section>
      )
    }
  </main><Footer /><script>
    document.getElementById("back-to-list")?.addEventListener("click", (e) => {
      if (
        document.referrer &&
        new URL(document.referrer).origin === location.origin
      ) {
        e.preventDefault();
        history.back();
      }
    });
  </script></Layout
>
