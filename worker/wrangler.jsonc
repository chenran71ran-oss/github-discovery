{
  "name": "github-discovery-collector",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["15 */6 * * *", "45 * * * *"],
  },
  "ai": {
    "binding": "AI",
  },
  "vars": {
    "AI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    "AI_BATCH_SIZE": "6",
    "META_BATCH_SIZE": "24",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "github-discovery-db",
      "database_id": "b4eb73ce-f62b-4168-99a4-8173e2482cc6",
      "migrations_dir": "../migrations",
    },
  ],
}
